# LOCAL DEVELOPMENT ONLY. Never use these credentials in production.
POSTGRES_USER=training_local
POSTGRES_PASSWORD=training_local_only
POSTGRES_DB=training_local
DATABASE_URL=postgresql://training_local:training_local_only@127.0.0.1:5432/training_local
PORT=3000
NODE_ENV=development
WEB_PORT=5173
API_PORT=3000
DB_PORT=5432
